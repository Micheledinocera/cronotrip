{
  "extends": "./.nuxt/tsconfig.app.json",
  "include": [
    "models/**/*.ts",
    "types/**/*.d.ts",
    ".nuxt/**/*.ts",
    "**/*.ts",
    "**/*.vue"
  ],   
  "compilerOptions": {
    "paths": {
      "*": ["./*"],
      "Types/*": ["./types/*"],
      "#components": ["./.nuxt/components.d.ts"],
      "#imports": ["./.nuxt/imports.d.ts"]
    }
  }, 
}
